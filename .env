# pgbouncer image
AUTH_TYPE=scram-sha-256
DB_NAME=comments
DB_USER=comments
DB_PASSWORD=comments
DB_HOST=db
DB_PORT=5432
MAX_CLIENT_CONN=1000
DEFAULT_POOL_SIZE=20

# postgres image
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}

# django
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=api.comments,localhost,127.0.0.1,web.comments

API_BASE_URL=http://api.comments:8002

JWT_ACCESS_TOKEN_LIFETIME=5 minutes
JWT_REFRESH_TOKEN_LIFETIME=1 day

CORS_ALLOWED_ORIGINS=http://dev.comments:5173,http://web.comments:8002,http://api.comments:8002
CSRF_TRUSTED_ORIGINS=http://dev.comments:5173,http://web.comments:8002,http://api.comments:8002

MASTER_CAPTCHA_VALUE=BqaCCGFi6X9MO0O0IMx2tEKaNKJ6sP_qjNTeWIQBg_mY

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
