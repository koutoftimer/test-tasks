FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

COPY requirements/ /requirements/
RUN pip install --no-cache-dir -r /requirements/prod-frozen.txt

WORKDIR /app
COPY src/backend/ /app/

ENV DJANGO_DEBUG=False
RUN python manage.py collectstatic --noinput

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8002

# Use the entrypoint to handle migrations
ENTRYPOINT ["/entrypoint.sh"]

# CMD is passed as arguments to the entrypoint (the "$@" part)
CMD ["gunicorn", "comments.wsgi:application", "--bind", "0.0.0.0:8002", "--workers", "4"]
